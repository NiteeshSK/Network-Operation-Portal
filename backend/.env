# ── Inside Docker (backend container → postgres container) ──────────────────
DATABASE_URL=postgresql://noc_user:noc_password@postgres:5432/noc_portal

# ── On host VM directly (psql, running backend outside Docker) ──────────────
# DATABASE_URL=postgresql://noc_user:noc_password@localhost:15432/noc_portal

# Chatbot / Ollama
OLLAMA_URL=http://10.25.167.101:11434
OLLAMA_MODEL=qwen3:32b
OLLAMA_TIMEOUT=120

# Keep 30 days of port_stats, arp_entries for analysis.
# Cleanup runs every hour; increase further if you need longer history.
NOC_RETENTION_DAYS=7
NOC_FORENSIC_RETENTION_DAYS=7
# ── RAG / vector layer ──────────────────────────────────────────────────────
# DEFAULT = on-prem: OpenAI client talks to Ollama's OpenAI-compatible /v1 API,
# so config/ARP/diff text never leaves the network.
# On the Ollama host, pull the embedding model once:
#     ollama pull nomic-embed-text
RAG_OPENAI_BASE_URL=http://10.25.167.101:11434/v1
RAG_OPENAI_API_KEY=ollama
RAG_EMBED_MODEL=nomic-embed-text
RAG_CHAT_MODEL=qwen3:32b

RAG_CHROMA_DIR=/data/chroma
RAG_CHROMA_COLLECTION=noc_portal
RAG_SYNC_MINUTES=5
RAG_RETRIEVE_K=6

# To use REAL OpenAI cloud instead (data WILL leave the network), set:
#   RAG_OPENAI_BASE_URL=https://api.openai.com/v1
#   RAG_OPENAI_API_KEY=sk-...
#   RAG_EMBED_MODEL=text-embedding-3-small
#   RAG_CHAT_MODEL=gpt-4o-mini
